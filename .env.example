AXIGNAL_ENV=development
AXIGNAL_API_URL=http://localhost:8000
AXIGNAL_DATABASE_URL=postgresql://axignal:axignal@localhost:5432/axignal
AXIGNAL_PROPOSAL_DATABASE_URL=postgresql://axignal_proposal_worker:axignal_proposal_worker@localhost:5432/axignal
AXIGNAL_ADMISSION_DATABASE_URL=postgresql://axignal_admission_runtime_login:axignal_admission_runtime@localhost:5432/axignal
AXIGNAL_HUMAN_REVIEW_DATABASE_URL=postgresql://axignal_human_reviewer_login:axignal_human_reviewer@localhost:5432/axignal
AXIGNAL_HUMAN_REVIEWER_SUBJECTS=usr_operator
AXIGNAL_SCHEDULER_DATABASE_URL=postgresql://axignal_scheduler_login:axignal_scheduler@localhost:5432/axignal
AXIGNAL_VALIDATION_DATABASE_URL=postgresql://axignal_validation_runtime_login:axignal_validation_runtime@localhost:5432/axignal
AXIGNAL_VALIDATION_ANALYST_DATABASE_URL=postgresql://axignal_validation_analyst_login:axignal_validation_analyst@localhost:5432/axignal
AXIGNAL_VALIDATION_PARTICIPANT_SALT=replace-with-at-least-32-random-bytes
AXIGNAL_VALKEY_URL=redis://localhost:6379/0
AXIGNAL_PERSISTENT_RESEARCH_ENABLED=false
AXIGNAL_PERSISTENT_RESEARCH_UI_ENABLED=false
AXIGNAL_DOCUMENT_PROPOSAL_UI_ENABLED=false
AXIGNAL_HUMAN_REVIEW_UI_ENABLED=false
AXIGNAL_VALIDATION_ENABLED=false
AXIGNAL_VALIDATION_UI_ENABLED=false
AXIGNAL_LIVE_SOURCES_ENABLED=false
AXIGNAL_SCHEDULER_ENABLED=false
AXIGNAL_RESEARCH_QUEUE_KEY=axignal:research:queue:v1
AXIGNAL_PROPOSAL_QUEUE_KEY=axignal:proposal:queue:v1
AXIGNAL_ADMISSION_QUEUE_KEY=axignal:admission:queue:v1
AXIGNAL_SCHEDULER_QUEUE_KEY=axignal:scheduler:queue:v1
AXIGNAL_WORLD_BANK_FIXTURE_PATH=apps/api/tests/fixtures/world_bank_rus_inflation.json
AXIGNAL_DOCUMENT_FIXTURE_PATH=apps/api/tests/fixtures/world_bank_rer41_document.json
AXIGNAL_DOCUMENT_PROPOSAL_FIXTURE_PATH=apps/api/tests/fixtures/world_bank_rer41_proposal.json

# Content-addressed object storage. "s3" requires deployment-time client wiring.
AXIGNAL_OBJECT_STORE_BACKEND=local
AXIGNAL_OBJECT_STORE_ROOT=.axignal/objects

# Optional local OpenAI-compatible proposal endpoint. Mutually exclusive with DeepSeek.
AXIGNAL_LOCAL_MODEL_BASE_URL=
AXIGNAL_LOCAL_MODEL_NAME=
AXIGNAL_LOCAL_MODEL_API_KEY=

# Direct DeepSeek proposal-only adapter. The API key is server-side and must never enter UI state.
AXIGNAL_DEEPSEEK_PROPOSAL_ENABLED=false
AXIGNAL_DEEPSEEK_BASE_URL=https://api.deepseek.com
AXIGNAL_DEEPSEEK_MODEL=deepseek-v4-flash
AXIGNAL_DEEPSEEK_MAX_OUTPUT_TOKENS=1200
AXIGNAL_DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_API_KEY=

# Authenticated identity gate. Required when persistent UI or validation is enabled.
AXIGNAL_AUTH_REQUIRED=false
AXIGNAL_AUTH_EMAIL=operator@example.com
AXIGNAL_AUTH_SUBJECT=usr_operator
AXIGNAL_AUTH_TENANT_ID=11111111-1111-4111-8111-111111111111
AXIGNAL_AUTH_PASSWORD_SCRYPT=scrypt$replace-with-salt-hex$replace-with-derived-key-hex
AXIGNAL_SESSION_SECRET=replace-with-at-least-32-random-bytes
AXIGNAL_IDENTITY_ASSERTION_SECRET=replace-with-at-least-32-random-bytes

# Server-only landing pilot intake. Leave empty to fail closed without storing a request.
AXIGNAL_PILOT_INTAKE_WEBHOOK_URL=
AXIGNAL_PILOT_INTAKE_BEARER_TOKEN=
AXIGNAL_PILOT_CONTACT_EMAIL=

AXIGNAL_OTEL_ENABLED=false
OTEL_SERVICE_NAME=axignal-local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
