{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "isolatedModules": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": "dist/tests",
    "rootDir": ".",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "lib/candidate-pricing-contract.ts",
    "lib/landing-data.ts",
    "tests/**/*.test.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
