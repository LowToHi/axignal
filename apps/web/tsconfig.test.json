{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "isolatedModules": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": "dist/tests",
    "rootDir": ".",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["lib/auth-token.ts", "tests/**/*.test.ts"],
  "exclude": ["node_modules", ".next", "dist"]
}
