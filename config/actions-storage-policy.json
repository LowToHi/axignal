      "diagnostic",
      "e2e-audit",
      "playwright",
      "screenshot",
      "test-results",
      "trace",
      "video",
      "viewport"
    ]
  },
  "workflow_limits": {
    "maximum_upload_steps_per_workflow": 8,
    "maximum_artifacts_per_run": 12,
    "require_explicit_retention_days": true,
    "forbid_dynamic_retention_days": true
  },
  "inventory": {
    "preserve_recent_hours": 24,
    "top_families": 50,
    "minimum_api_remaining": 250
  },
  "trusted_runner": {
    "name": "axignal-trusted-01",
    "labels": [
      "self-hosted",
      "linux",
      "x64",
      "axignal",
      "trusted"
    ],
    "service_user": "runner-axignal",
    "install_root": "/opt/actions-runner-axignal",
    "work_root": "/var/lib/axignal-runner/work",
    "cache_root": "/var/cache/axignal",
    "cache_budget_gib": 25,
    "allowed_events": [
      "push:refs/heads/main",
      "workflow_dispatch"
    ],
    "forbidden_events": [
      "pull_request",
      "pull_request_target"
    ]
  }
