ed","security_incident","privacy_violation","source_request","quality_failure","operator_kill_switch"],"required_actions":["stop_fetch","stop_materialisation","invalidate_allow_cache","cancel_queued_work","emit_tombstones","propagate_deletion_or_restriction","preserve_audit","require_new_profile_for_reentry"],"rules":["Kill switch evaluation precedes every fetch, replay, materialisation and export.","Revoked material contributes zero to new decisions.","Deletion propagation is rights-aware and does not erase required governance evidence."]},"security_contract":{"network_controls":["exact_origin_allowlist","redirect_revalidation","dns_rebinding_defence","private_address_denial","tls_validation","payload_size_limit","archive_expansion_limit"],"runtime_controls":["isolated_process","read_only_root","non_root_identity","minimal_egress","secret_reference_only","cpu_memory_time_limits","no_shell_by_default"],"rules":["Connector code is treated as untrusted even when maintained internally.","Authentication material is tenant-scoped and cannot be reused across source profiles.","Downloaded content cannot execute code or expand without deterministic bounds.","Source data cannot alter connector policy, tools, network allowlists or admission decisions."]},"reference_profiles":[{"profile_id":"AX-SRC-REF-OPEN-METADATA","profile_kind":"REFERENCE_ONLY","state":"SANDBOX","endpoint_origin":"https://open-metadata.example.invalid","auth_mode":"NONE","personal_data_policy":"PROHIBITED","content_mode":"METADATA_ONLY","rights_snapshot":{"collection":"ALLOW","transient_processing":"ALLOW","persistent_storage":"ALLOW","model_input":"DENY","derived_calculations":"ALLOW","internal_display":"ALLOW","customer_display":"DENY","export":"DENY","api_redistribution":"DENY","model_training_or_evaluation":"DENY"},"admission_authorised":false},{"profile_id":"AX-SRC-REF-RESTRICTED-DOCUMENT","profile_kind":"REFERENCE_ONLY","state":"SANDBOX","endpoint_origin":"https://restricted-documents.example.invalid