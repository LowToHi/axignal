_policy","deletion_policy","kill_switch","observability","rollback"],"rights_dimensions":["collection","transient_processing","persistent_storage","model_input","derived_calculations","internal_display","customer_display","export","api_redistribution","model_training_or_evaluation"],"legal_authority_states":["UNREVIEWED","REVIEW_REQUIRED","APPROVED","REJECTED","EXPIRED","REVOKED"],"personal_data_policies":["PROHIBITED","MINIMISE","MINIMISE_AND_QUARANTINE","EXPLICITLY_APPROVED"],"content_modes":["NONE","METADATA_ONLY","TRANSIENT_PARSE_DERIVED_ONLY","FULL_CONTENT_EXPLICIT_RIGHT"],"rules":["Endpoint origins use exact scheme and host allowlists; wildcard origins are prohibited.","Credentials are secret references, never profile values, URLs, logs or candidate objects.","Rights decisions are per dimension and cannot be inferred from a general licence label.","A profile change invalidates prior preflight and admission decisions.","Reference profiles use example.invalid and cannot be treated as product-admitted sources."]},"admission_pipeline":{"stages":[{"stage_id":"S01_PROFILE","input":"connector_package","output":"source_profile","required_gate_ids":["G01_LEGAL_AUTHORITY","G02_RIGHTS_MATRIX"]},{"stage_id":"S02_PREFLIGHT","input":"source_profile","output":"preflight_record","required_gate_ids":["G03_PRIVACY_CLASSIFICATION","G04_SECURITY_PREFLIGHT","G11_RATE_AND_COST"]},{"stage_id":"S03_SANDBOX_FETCH","input":"preflight_record","output":"raw_transient_payload","required_gate_ids":["G12_OUTAGE_POLICY","G14_OBSERVABILITY"]},{"stage_id":"S04_PARSE_NORMALIZE","input":"raw_transient_payload","output":"normalized_candidate_records","required_gate_ids":["G05_PROVENANCE","G06_SCHEMA_CONFORMANCE","G08_TEMPORAL_SEMANTICS","G09_TAXONOMY_MAPPING"]},{"stage_id":"S05_QUALITY_RECONCILE","input":"normalized_candidate_records","output":"quality_report","required_gate_ids":["G07_QUALITY_THRESHOLDS","G10_IDEMPOTENCY"]},{"stage_id":"S06_CANDIDATE_HANDOFF","input":"quality_report","output":"c