OMY_MAPPING","domain":"EPISTEMIC","required_evidence":["source_native_taxonomy","crosswalk_version","unmapped_policy"],"pass_state":"PASS","fail_state":"QUARANTINE","human_authority_required":false},{"gate_id":"G10_IDEMPOTENCY","domain":"RELIABILITY","required_evidence":["source_object_key","cursor","deduplication_key","replay_policy"],"pass_state":"PASS","fail_state":"SUSPEND","human_authority_required":false},{"gate_id":"G11_RATE_AND_COST","domain":"OPERATIONS","required_evidence":["rate_limit","retry_budget","cost_budget","circuit_breaker"],"pass_state":"PASS","fail_state":"SUSPEND","human_authority_required":false},{"gate_id":"G12_OUTAGE_POLICY","domain":"OPERATIONS","required_evidence":["healthcheck","stale_read_policy","outage_state","recovery_probe"],"pass_state":"PASS","fail_state":"SUSPEND","human_authority_required":false},{"gate_id":"G13_REVOCATION_AND_DELETION","domain":"DATA_RIGHTS","required_evidence":["kill_switch","revocation_path","deletion_propagation","tombstone_policy"],"pass_state":"PASS","fail_state":"DENY","human_authority_required":true},{"gate_id":"G14_OBSERVABILITY","domain":"OPERATIONS","required_evidence":["metrics","structured_logs","trace_ids","alerts"],"pass_state":"PASS","fail_state":"SUSPEND","human_authority_required":false},{"gate_id":"G15_ROLLBACK","domain":"GOVERNANCE","required_evidence":["rollback_plan","checkpoint_restore","residual_scan"],"pass_state":"PASS","fail_state":"DENY","human_authority_required":false},{"gate_id":"G16_HUMAN_ADMISSION","domain":"GOVERNANCE","required_evidence":["security_approval","rights_approval","product_approval"],"pass_state":"PASS","fail_state":"DENY","human_authority_required":true}],"decision_states":["PASS","DENY","QUARANTINE","SUSPEND","NOT_APPLICABLE","INDETERMINATE"],"default_decision":"DENY","rules":["Every stage records immutable inputs, outputs, policy version and reason codes.","INDETERMINATE is treated as DENY.","A later gate cannot override a prior DENY or active kill switch.","Only 