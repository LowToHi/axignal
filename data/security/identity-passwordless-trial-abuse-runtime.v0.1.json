{
  "schema": "axignal.identity-passwordless-trial-abuse-runtime.v0.1",
  "task": "AX-GE2E-P25-T01",
  "status": "IMPLEMENTED_NOT_PUBLIC",
  "policy_versions": {
    "identity": "identity-policy@1.0.0",
    "session": "session-policy@1.0.0",
    "trial_risk": "trial-risk-policy@1.0.0"
  },
  "identity": {
    "primary_authenticator": "WEBAUTHN_PASSKEY",
    "user_verification": "REQUIRED",
    "resident_key": "REQUIRED",
    "attestation": "NONE",
    "email_role": "ADDRESS_VERIFICATION_AND_BOOTSTRAP_ONLY",
    "passwordless": true,
    "password_public_path": false,
    "tenant_from_browser": false
  },
  "sessions": {
    "type": "OPAQUE_SERVER_SIDE_REVOCABLE",
    "cookie": {
      "production_name": "__Host-axignal_session",
      "http_only": true,
      "secure_in_production": true,
      "same_site": "Lax",
      "path": "/",
      "domain_attribute": false
    },
    "idle_timeout_seconds": 3600,
    "absolute_timeout_seconds": 86400,
    "api_assertion_ttl_seconds": 60,
    "local_storage": false
  },
  "trial": {
    "owner": "TENANT_ECONOMIC_IDENTITY",
    "duration_seconds": 604800,
    "starts_on": "FIRST_ADMITTED_AI_REQUEST",
    "seat_capacity": 2,
    "token_budget_ceiling": 1000000,
    "cost_budget_enforced": true,
    "max_concurrent_research_runs": 1,
    "direct_activation_allowed": false,
    "new_account_implies_new_trial": false
  },
  "anti_abuse": {
    "strong_claims": [
      "EMAIL_IDENTITY",
      "VERIFIED_PHONE",
      "PAYMENT_INSTRUMENT"
    ],
    "weak_claims": [
      "INSTALLATION",
      "NETWORK_PREFIX",
      "DOMAIN"
    ],
    "strong_claim_reuse": "REUSE_EXISTING_TRIAL",
    "weak_signal_can_independently_block": false,
    "gmail_dot_and_plus_alias_canonicalisation": true,
    "low_entropy_values": "HMAC_SHA256_WITH_VERSIONED_PEPPER",
    "bot_verification": "SERVER_SIDE_ADAPTIVE",
    "decisions": [
      "ALLOW",
      "ALLOW_RESTRICTED",
      "REUSE_EXISTING_TRIAL",
      "STEP_UP_REQUIRED",
      "MANUAL_REVIEW",
      "BLOCK_ABUSE"
    ]
  },
  "recovery": {
    "codes_per_registration": 8,
    "single_use": true,
    "revokes_existing_sessions": true,
    "requires_new_passkey": true
  },
  "authority": {
    "identity_store": "POSTGRESQL_IDENTITY_PRIVATE",
    "trial_store": "POSTGRESQL_IDENTITY_PRIVATE",
    "seat_store": "POSTGRESQL_TENANT_PRIVATE",
    "risk_ledger_append_only": true,
    "security_ledger_append_only": true,
    "public_signup_enabled": false,
    "production_email_provider_approved": false,
    "production_bot_provider_approved": false,
    "commercial_activation_authorised": false
  }
}
