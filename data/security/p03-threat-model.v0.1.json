{"schema_version":"axignal.security-threat-model/v0.1","task_id":"AX-GE2E-P03-T01","programme_version":"1.4.0","status":"DRAFT_ENGINEERING_FOUNDATION","methodology":"STRIDE_PLUS_RIGHTS_PRIVACY_AND_EPISTEMIC_AUTHORITY","assets":["principal_credentials","server_sessions","organisation_memberships","role_bindings","capability_policies","tenant_and_workspace_scope","source_rights_snapshots","evidence_and_claims","exports","audit_chain","kill_switches","security_configuration"],"trust_boundaries":[{"boundary_id":"AX-P03-TB-01","from":"BROWSER","to":"SERVER_EDGE","rule":"All client input is untrusted; authentication material is opaque and authority fields are ignored."},{"boundary_id":"AX-P03-TB-02","from":"SERVER_EDGE","to":"POLICY_ENGINE","rule":"Only server-resolved principal, scope and resource facts enter authorization."},{"boundary_id":"AX-P03-TB-03","from":"POLICY_ENGINE","to":"DATABASE","rule":"Transaction-local RLS context is set only after an ALLOW decision."},{"boundary_id":"AX-P03-TB-04","from":"WORKER","to":"CANONICAL_RUNTIME","rule":"Worker identity is workload-scoped and cannot admit, export or widen authority."},{"boundary_id":"AX-P03-TB-05","from":"MODEL_OUTPUT","to":"APPLICATION","rule":"Model output is data or proposal only and has zero authorization authority."},{"boundary_id":"AX-P03-TB-06","from":"APPLICATION","to":"EXPORT_DELIVERY","rule":"Delivery re-evaluates rights, classification, approval, audience and expiry."}],"threats":[{"threat_id":"AX-P03-TH-001","category":"SPOOFING","scenario":"Tenant or workspace spoofing from browser-controlled input","mandatory_controls":["Trusted server scope resolution","ignore client authority fields"],"expected_decision":"DENY","adversarial_case_id":"AX-P03-ADV-001"},{"threat_id":"AX-P03-TH-002","category":"AUTHORIZATION","scenario":"Cross-tenant IDOR using a valid foreign resource identifier","mandatory_controls":["Tenant-scoped lookup","uniform non-disclosure","RLS"],"expected_decision":"DENY_NON_DISCLOSING","adversarial_case_id":"AX-P03-ADV-002"},{"threat_id":"AX-P03-TH-003","category":"ELEVATION_OF_PRIVILEGE","scenario":"Client submits a higher role or capability set","mandatory_controls":["Ignore client roles and capabilities","server-side binding intersection"],"expected_decision":"DENY","adversarial_case_id":"AX-P03-ADV-003"},{"threat_id":"AX-P03-TH-004","category":"CONFUSED_DEPUTY","scenario":"Service worker reuses operator authority outside assigned work","mandatory_controls":["Workload identity","action/resource scope","no delegated ambient authority"],"expected_decision":"DENY","adversarial_case_id":"AX-P03-ADV-004"},{"threat_id":"AX-P03-TH-005","category":"AUTHORIZATION","scenario":"Revoked membership remains in an authorization cache","mandatory_controls":["Immediate cache invalidation","membership version binding"],"expected_decision":"DENY","adversarial_case_id":"AX-P03-ADV-005"},{"threat_id":"AX-P03-TH-006","category":"DATABASE","scenario":"Application role owns tables or has BYPASSRLS","mandatory_controls":["Runtime role separation","FORCE RLS","CI privilege assertions"],"expected_decision":"FAIL_CLOSED","adversarial_case_id":"AX-P03-ADV-006"},{"threat_id":"AX-P03-TH-007","category":"DATABASE","scenario":"SECURITY DEFINER function is exploitable through search_path or unchecked scope","mandatory_controls":["Pinned search_path","explicit scope checks","minimal executable surface"],"expected_decision":"DENY","adversarial_case_id":"AX-P03-ADV-007"},{"threat_id":"AX-P03-TH-008","category":"SESSION","scenario":"Session fixation or replay after authentication or privilege change","mandatory_controls":["Rotation","credential-version binding","replay detection"],"expected_decision":"DENY","adversarial_case_id":"AX-P03-ADV-008"},{"threat_id":"AX-P03-TH-009","category":"SESSION","scenario":"Cross-site request triggers a sensitive mutation","mandatory_controls":["SameSite Strict","CSRF token","origin checks"],"expected_decision":"DENY","adversarial_case_id":"AX-P03-ADV-009"},{"threat_id":"AX-P03-TH-010","category":"DATA_EXFILTRATION","scenario":"research:read is treated as permission to export","mandatory_controls":["Separate export:create and export:approve capabilities"],"expected_decision":"DENY","adversarial_case_id":"AX-P03-ADV-010"},{"threat_id":"AX-P03-TH-011","category":"RIGHTS","scenario":"A stale export approval survives source-rights revocation","mandatory_controls":["Version-pinned rights snapshot","re-evaluation at materialisation and delivery"],"expected_decision":"DENY","adversarial_case_id":"AX-P03-ADV-011"},{"threat_id":"AX-P03-TH-012","category":"RIGHTS","scenario":"Source kill switch is bypassed by cached or queued work","mandatory_controls":["Kill-switch precedence","queue cancellation","cache invalidation"],"expected_decision":"DENY","adversarial_case_id":"AX-P03-ADV-012"},{"threat_id":"AX-P03-TH-013","category":"AI_AUTHORITY","scenario":"Model output proposes itself as administrator or approver","mandatory_controls":["Model authority is zero","typed proposal boundary","human/server admission only"],"expected_decision":"DENY","adversarial_case_id":"AX-P03-ADV-013"},{"threat_id":"AX-P03-TH-014","category":"DATA_CLASSIFICATION","scenario":"Automated classifier silently downgrades RESTRICTED data","mandatory_controls":["No automated downgrade","human authority and replacement linkage"],"expected_decision":"DENY","adversarial_case_id":"AX-P03-ADV-014"},{"threat_id":"AX-P03-TH-015","category":"PRIVACY","scenario":"Personal or secret material leaks into audit events","mandatory_controls":["Field allowlist","secret detector","minimised identifiers"],"expected_decision":"REDACT_OR_DENY","adversarial_case_id":"AX-P03-ADV-015"},{"threat_id":"AX-P03-TH-016","category":"NON_DISCLOSURE","scenario":"Different errors reveal whether a foreign resource exists","mandatory_controls":["Uniform external response and timing budget"],"expected_decision":"DENY_NON_DISCLOSING","adversarial_case_id":"AX-P03-ADV-016"},{"threat_id":"AX