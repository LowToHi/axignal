# Copy to a private file outside version control and replace every placeholder.
AXIGNAL_BUILD_SHA=replace-with-deployed-commit-sha
AXIGNAL_PILOT_SITE_ADDRESS=https://pilot.example.com
AXIGNAL_PILOT_ACME_EMAIL=operator@example.com
AXIGNAL_PILOT_HTTP_PORT=8080
AXIGNAL_PILOT_HTTPS_PORT=8443

AXIGNAL_POSTGRES_DB=axignal
AXIGNAL_POSTGRES_USER=axignal
AXIGNAL_POSTGRES_PASSWORD=replace-with-long-random-secret
AXIGNAL_PROPOSAL_DB_PASSWORD=replace-with-long-random-secret
AXIGNAL_ADMISSION_DB_PASSWORD=replace-with-long-random-secret
AXIGNAL_HUMAN_REVIEW_DB_PASSWORD=replace-with-long-random-secret
AXIGNAL_VALIDATION_DB_PASSWORD=replace-with-long-random-secret
AXIGNAL_VALIDATION_ANALYST_DB_PASSWORD=replace-with-long-random-secret
AXIGNAL_SCHEDULER_DB_PASSWORD=replace-with-long-random-secret

AXIGNAL_AUTH_EMAIL=operator@example.com
AXIGNAL_AUTH_SUBJECT=usr_pilot_operator
AXIGNAL_AUTH_TENANT_ID=11111111-1111-4111-8111-111111111111
AXIGNAL_AUTH_PASSWORD_SCRYPT=scrypt$replace-with-salt-hex$replace-with-derived-key-hex
AXIGNAL_SESSION_SECRET=replace-with-at-least-32-random-bytes
AXIGNAL_IDENTITY_ASSERTION_SECRET=replace-with-at-least-32-random-bytes
AXIGNAL_VALIDATION_PARTICIPANT_SALT=replace-with-at-least-32-random-bytes

AXIGNAL_OTEL_ENABLED=false
