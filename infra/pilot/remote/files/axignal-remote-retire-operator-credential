#!/usr/bin/env bash
set -Eeuo pipefail

STATE_ROOT="${AXIGNAL_REMOTE_STATE_ROOT:-/var/lib/axignal/ops}"
CREDENTIAL_HELPER="${AXIGNAL_CREDENTIAL_HELPER:-/usr/local/lib/axignal/prepare_env.py}"
PASSWORD_FILE="${1:?usage: axignal-remote-retire-operator-credential <delivered-password-file>}"
METADATA_FILE="${2:-$STATE_ROOT/credential-metadata.json}"

[[ "$EUID" -eq 0 ]] || { echo 'operator credential retirement must run as root' >&2; exit 2; }
[[ -f "$CREDENTIAL_HELPER" ]] || { echo 'missing credential helper' >&2; exit 2; }

umask 077
python3 "$CREDENTIAL_HELPER" retire \
  --password-file "$PASSWORD_FILE" \
  --metadata-output "$METADATA_FILE"
