{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axignal.com/schemas/admission-handoff.schema.json",
  "title": "AXIGNAL Admission Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "research_run_id",
    "pipeline_version",
    "document",
    "source",
    "fragments",
    "evidence",
    "candidate_claims",
    "admission_boundary_results",
    "dossier",
    "actual_usage",
    "human_review_state",
    "canonical_claim_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "tenant_id": {"type": "string", "format": "uuid"},
    "research_run_id": {"type": "string", "format": "uuid"},
    "pipeline_version": {"const": "local-document-proposal-pipeline@0.1.0"},
    "document": {"type": "object", "additionalProperties": true},
    "source": {
      "type": "object",
      "required": ["source_id", "rights_status", "admission_state", "kill_switch"],
      "additionalProperties": true
    },
    "fragments": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "candidate_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "object"}
    },
    "admission_boundary_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["admitted", "canonical_claim_id"],
        "properties": {
          "admitted": {"const": false},
          "canonical_claim_id": {"type": "null"}
        },
        "additionalProperties": true
      }
    },
    "dossier": {"type": "object", "additionalProperties": true},
    "actual_usage": {"type": "object", "additionalProperties": true},
    "human_review_state": {"enum": ["NOT_REQUESTED", "REQUESTED", "COMPLETED"]},
    "canonical_claim_ids": {"type": "array", "maxItems": 0}
  }
}
