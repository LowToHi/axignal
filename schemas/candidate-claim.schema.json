{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axignal.com/schemas/candidate-claim.schema.json",
  "title": "AXIGNAL Candidate Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_claim_id",
    "tenant_scope",
    "subject_ref",
    "predicate",
    "object",
    "proposed_claim_type",
    "state",
    "evidence_ids",
    "source_ids",
    "producer",
    "rights_status",
    "created_at"
  ],
  "properties": {
    "candidate_claim_id": {
      "type": "string",
      "pattern": "^ccl_[A-Za-z0-9_-]{8,}$"
    },
    "tenant_scope": {
      "enum": ["GLOBAL", "TENANT_PRIVATE", "ENTERPRISE_PRIVATE"]
    },
    "tenant_id": {
      "type": ["string", "null"]
    },
    "research_run_id": {
      "type": ["string", "null"]
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "type": ["string", "number", "boolean", "object", "array", "null"]
    },
    "proposed_claim_type": {
      "enum": [
        "OBSERVED_QUALITATIVE",
        "OBSERVED_QUANTITATIVE",
        "CALCULATED",
        "RELATIONAL",
        "TREND",
        "CAUSAL_HYPOTHESIS",
        "PREDICTIVE",
        "COMMERCIAL_HYPOTHESIS",
        "EXPERIMENTAL_RESULT",
        "OUTCOME",
        "RISK",
        "LEGAL_OR_REGULATORY"
      ]
    },
    "state": {
      "enum": [
        "PROPOSED",
        "PARSED",
        "EVIDENCE_BOUND",
        "DUPLICATE_CHECKED",
        "SOURCE_CHECKED",
        "RIGHTS_CHECKED",
        "STRUCTURALLY_VALIDATED",
        "TEMPORALLY_VALIDATED",
        "QUANTITATIVELY_VALIDATED",
        "EPISTEMICALLY_REVIEWED",
        "ADMISSION_QUEUED",
        "DUPLICATE",
        "INSUFFICIENT_EVIDENCE",
        "RIGHTS_BLOCKED",
        "SOURCE_BLOCKED",
        "CONTESTED",
        "QUARANTINED",
        "REJECTED",
        "EXPIRED",
        "MODEL_FAILURE",
        "BUDGET_EXHAUSTED"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geography_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "jurisdictions": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "valid_from": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "valid_to": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "observed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "adverse_evidence_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "source_lineage_group_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "contradiction_candidate_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "unknowns": {
      "type": "array",
      "items": {"type": "string"}
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_type", "producer_id", "method_version"],
      "properties": {
        "producer_type": {
          "enum": ["LOCAL_MODEL", "EXTERNAL_MODEL", "DETERMINISTIC_PARSER", "HUMAN"]
        },
        "producer_id": {
          "type": "string"
        },
        "model_id": {
          "type": ["string", "null"]
        },
        "provider_id": {
          "type": ["string", "null"]
        },
        "method_version": {
          "type": "string"
        },
        "prompt_template_id": {
          "type": ["string", "null"]
        }
      }
    },
    "extraction_confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "rights_status": {
      "enum": ["UNREVIEWED", "RIGHTS_VALID", "RESTRICTED", "BLOCKED"]
    },
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "result", "evaluated_at", "policy_version"],
        "properties": {
          "gate": {
            "enum": [
              "STRUCTURAL",
              "SOURCE",
              "RIGHTS",
              "TEMPORAL",
              "QUANTITATIVE",
              "EPISTEMIC",
              "TENANT_SCOPE"
            ]
          },
          "result": {
            "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]
          },
          "reason": {
            "type": ["string", "null"]
          },
          "evaluated_at": {
            "type": "string",
            "format": "date-time"
          },
          "policy_version": {
            "type": "string"
          }
        }
      }
    },
    "admission_batch_id": {
      "type": ["string", "null"]
    },
    "canonical_claim_id": {
      "type": ["string", "null"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
