{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axignal.com/schemas/command-plan.schema.json",
  "title": "AXIGNAL Navigator Command Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_plan_id", "context_id", "original_message", "language", "intent", "confidence", "operations", "preferred_lens", "requires_confirmation", "created_at"],
  "properties": {
    "command_plan_id": {"type": "string", "pattern": "^cmd_[A-Za-z0-9_-]{8,}$"},
    "context_id": {"type": "string"},
    "original_message": {"type": "string", "minLength": 1},
    "language": {"enum": ["en", "es", "fr", "de", "pt-BR", "zh-Hans"]},
    "intent": {
      "enum": [
        "NAVIGATE_GEOGRAPHY",
        "NAVIGATE_ENTITY",
        "DISCOVER_OPPORTUNITIES",
        "SET_UNIVERSE",
        "SET_FILTER",
        "SET_TIME",
        "COMPARE_SUBJECTS",
        "CHANGE_LENS",
        "INSPECT_CLAIM",
        "INSPECT_EVIDENCE",
        "SHOW_CONTRADICTIONS",
        "SHOW_TRANSMISSION",
        "EXPLAIN_CURRENT_VIEW",
        "SAVE_INVESTIGATION_TRAIL",
        "UPDATE_PRIVATE_INTEREST",
        "QUEUE_RESEARCH_CANDIDATE"
      ]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "entities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "geographies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "universes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "time": {"type": ["object", "null"], "additionalProperties": true},
    "filters": {"type": "object", "additionalProperties": true},
    "preferred_lens": {"enum": ["AUTO", "GLOBE", "GRAPH", "DUAL"]},
    "lens_reason": {"type": ["string", "null"]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "operation_type", "reversible"],
        "properties": {
          "operation_id": {"type": "string"},
          "operation_type": {"type": "string"},
          "parameters": {"type": "object", "additionalProperties": true},
          "reversible": {"type": "boolean"},
          "entitlement_required": {"type": ["string", "null"]}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "ambiguities": {"type": "array", "items": {"type": "string"}},
    "requires_confirmation": {"type": "boolean"},
    "confirmation_reason": {"type": ["string", "null"]},
    "intent_recording": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eligible": {"type": "boolean"},
        "raw_message_retention": {"type": "boolean"},
        "private_memory": {"type": "boolean"},
        "aggregate_tide_use": {"type": "boolean"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
