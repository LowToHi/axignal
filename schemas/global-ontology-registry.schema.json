{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axignal.com/schemas/global-ontology-registry.schema.json",
  "title": "AXIGNAL Global Ontology Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "programme_version",
    "status",
    "canonical_activation_authorised",
    "human_authorised_branch_start",
    "dependency_status",
    "namespace",
    "contract_families",
    "foundational_libraries",
    "opportunity_libraries",
    "universe_contract",
    "source_contract",
    "evidence_contract",
    "claim_contract",
    "entity_contract",
    "taxonomy_contract",
    "temporal_contract",
    "opportunity_contract",
    "cross_library_invariants",
    "acceptance_gate"
  ],
  "properties": {
    "schema_version": {
      "const": "axignal.global-ontology-registry/v0.1"
    },
    "task_id": {
      "const": "AX-GE2E-P02-T01"
    },
    "programme_version": {
      "const": "1.4.0"
    },
    "status": {
      "enum": [
        "DRAFT_IMPLEMENTATION_FOUNDATION",
        "EVIDENCE_READY",
        "ACCEPTED",
        "SUPERSEDED"
      ]
    },
    "canonical_activation_authorised": {
      "type": "boolean"
    },
    "human_authorised_branch_start": {
      "type": "boolean"
    },
    "dependency_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p01_task",
        "p01_canonical_state",
        "p01_dependency_satisfied",
        "merge_to_main_allowed"
      ],
      "properties": {
        "p01_task": {
          "const": "AX-GE2E-P01-T01"
        },
        "p01_canonical_state": {
          "enum": [
            "IN_PROGRESS",
            "EVIDENCE_READY",
            "ACCEPTED",
            "REJECTED",
            "SUPERSEDED"
          ]
        },
        "p01_dependency_satisfied": {
          "type": "boolean"
        },
        "merge_to_main_allowed": {
          "type": "boolean"
        }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "identifier_policy",
        "schema_compatibility"
      ],
      "properties": {
        "canonical": {
          "const": "https://axignal.com/ontology/"
        },
        "identifier_policy": {
          "type": "string",
          "minLength": 3
        },
        "schema_compatibility": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "contract_families": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contractFamily"
      }
    },
    "foundational_libraries": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/library"
          },
          {
            "properties": {
              "library_id": {
                "pattern": "^AX-LIB-F0[1-7]$"
              },
              "kind": {
                "const": "FOUNDATIONAL"
              },
              "shared_across_all_opportunity_libraries": {
                "const": true
              }
            },
            "required": [
              "shared_across_all_opportunity_libraries"
            ]
          }
        ]
      }
    },
    "opportunity_libraries": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/library"
          },
          {
            "properties": {
              "library_id": {
                "pattern": "^AX-LIB-O0[1-9]$"
              },
              "kind": {
                "const": "OPPORTUNITY"
              },
              "workspace_type": {
                "type": "string",
                "minLength": 3
              }
            },
            "required": [
              "workspace_type"
            ]
          }
        ]
      }
    },
    "universe_contract": {
      "$ref": "#/$defs/ruleContract"
    },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "states",
        "rights_dimensions",
        "required_fields",
        "default_when_rights_ambiguous"
      ],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 11,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rights_dimensions": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "required_fields": {
          "type": "array",
          "minItems": 20,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "default_when_rights_ambiguous": {
          "const": "RESTRICTED"
        }
      }
    },
    "evidence_contract": {
      "$ref": "#/$defs/complexContract"
    },
    "claim_contract": {
      "$ref": "#/$defs/openContract"
    },
    "entity_contract": {
      "$ref": "#/$defs/openContract"
    },
    "taxonomy_contract": {
      "$ref": "#/$defs/openContract"
    },
    "temporal_contract": {
      "$ref": "#/$defs/openContract"
    },
    "opportunity_contract": {
      "$ref": "#/$defs/openContract"
    },
    "cross_library_invariants": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invariant_id",
          "rule"
        ],
        "properties": {
          "invariant_id": {
            "pattern": "^AX-INV-[0-9]{3}$"
          },
          "rule": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "acceptance_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_before_canonical_activation",
        "current_decision"
      ],
      "properties": {
        "required_before_canonical_activation": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "string"
          }
        },
        "current_decision": {
          "enum": [
            "NOT_READY_FOR_CANONICAL_ACTIVATION",
            "READY_FOR_HUMAN_ACCEPTANCE",
            "ACCEPTED",
            "REJECTED"
          ]
        }
      }
    }
  },
  "$defs": {
    "contractFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "name",
        "purpose"
      ],
      "properties": {
        "contract_id": {
          "pattern": "^AX-ONT-[A-Z]{1,2}[0-9]{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "purpose": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "library": {
      "type": "object",
      "required": [
        "library_id",
        "kind",
        "canonical_name",
        "contract_version",
        "state",
        "dependencies",
        "public_product_availability"
      ],
      "properties": {
        "library_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "FOUNDATIONAL",
            "OPPORTUNITY"
          ]
        },
        "canonical_name": {
          "type": "string",
          "minLength": 3
        },
        "workspace_type": {
          "type": "string"
        },
        "contract_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "state": {
          "enum": [
            "DRAFT",
            "EVIDENCE_READY",
            "ACCEPTED",
            "SUPERSEDED"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "pattern": "^AX-LIB-[FO]0[1-9]$"
          },
          "uniqueItems": true
        },
        "shared_across_all_opportunity_libraries": {
          "type": "boolean"
        },
        "public_product_availability": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ruleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_fields",
        "rules"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "complexContract": {
      "type": "object",
      "required": [
        "required_fields",
        "rules"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "immutable_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      },
      "additionalProperties": false
    },
    "openContract": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "array"
          },
          {
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  }
}
