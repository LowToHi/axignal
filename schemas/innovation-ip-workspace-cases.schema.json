{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axignal.com/schemas/innovation-ip-workspace-cases.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "scopes", "threats", "expected_by_threat"],
  "properties": {
    "schema_version": {"const": "axignal.innovation-ip-workspace-cases/v0.1"},
    "task_id": {"const": "AX-GE2E-P16-T01"},
    "scopes": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string"}},
    "threats": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "expected_by_threat": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "type": "object",
        "required": ["decision", "canonical_delta", "external_action_delta", "reason_code"],
        "properties": {
          "decision": {"type": "string"},
          "canonical_delta": {"const": 0},
          "external_action_delta": {"const": 0},
          "reason_code": {"type": "string"}
        }
      }
    }
  }
}
