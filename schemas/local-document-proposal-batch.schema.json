{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axignal.dev/schemas/local-document-proposal-batch.schema.json",
  "title": "AXIGNAL Local Document Proposal Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer_type",
    "producer_id",
    "model_version",
    "method_version",
    "prompt_version",
    "claims",
    "explicit_unknowns"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "producer_type": { "const": "LOCAL_MODEL" },
    "producer_id": { "type": "string", "minLength": 3 },
    "model_version": { "type": "string", "minLength": 1 },
    "method_version": { "type": "string", "minLength": 3 },
    "prompt_version": { "type": "string", "minLength": 3 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/proposedClaim" }
    },
    "explicit_unknowns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "fragmentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragment_id", "quote_hash"],
      "properties": {
        "fragment_id": { "type": "string", "pattern": "^frag_[0-9a-f]{20}$" },
        "quote_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "proposedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "predicate",
        "object_value",
        "statement",
        "kind",
        "relationship",
        "source_fragments",
        "assumptions",
        "unknowns",
        "extraction_confidence"
      ],
      "properties": {
        "subject_id": { "type": "string", "minLength": 3 },
        "predicate": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,}$" },
        "object_value": { "type": "object" },
        "statement": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "kind": {
          "enum": ["FACT", "FORECAST", "LIMITATION", "CONTRADICTION"]
        },
        "relationship": { "enum": ["SUPPORTING", "ADVERSE", "CONTEXT"] },
        "source_fragments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/fragmentReference" }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string" }
        },
        "unknowns": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string" }
        },
        "extraction_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
