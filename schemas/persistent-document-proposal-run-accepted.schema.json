{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axignal.com/schemas/persistent-document-proposal-run-accepted.schema.json",
  "title": "Persistent Document Proposal ResearchRun Accepted",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_run_id",
    "state",
    "queue_delivery",
    "source_ids",
    "document_id",
    "job_kind",
    "synthetic"
  ],
  "properties": {
    "research_run_id": {"type": "string", "format": "uuid"},
    "state": {"const": "QUEUED"},
    "queue_delivery": {"enum": ["PUBLISHED", "OUTBOX_PENDING"]},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"const": "world-bank-rer41"}
    },
    "document_id": {"const": "doc_world_bank_rer41"},
    "job_kind": {"const": "DOCUMENT_PROPOSAL"},
    "synthetic": {"const": false}
  }
}
