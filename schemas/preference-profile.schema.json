{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axignal.com/schemas/preference-profile.schema.json",
  "title": "AXIGNAL Private Preference Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "user_id", "memory_enabled", "preferences", "updated_at"],
  "properties": {
    "profile_id": {"type": "string", "pattern": "^prf_[A-Za-z0-9_-]{8,}$"},
    "user_id": {"type": "string", "minLength": 1},
    "memory_enabled": {"type": "boolean"},
    "preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preference_id", "level", "subject_type", "subject_id", "confidence", "valid_from", "expiry_policy", "evidence_event_ids"],
        "properties": {
          "preference_id": {"type": "string"},
          "level": {"enum": ["OBSERVED_INTEREST", "INFERRED_PREFERENCE", "CONFIRMED_PREFERENCE"]},
          "subject_type": {"enum": ["GEOGRAPHY", "ENTITY", "UNIVERSE", "SECTOR", "ASSET_CLASS", "CLAIM_TYPE", "TIME_HORIZON", "FILTER"]},
          "subject_id": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "valid_from": {"type": "string", "format": "date-time"},
          "last_observed_at": {"type": ["string", "null"], "format": "date-time"},
          "expires_at": {"type": ["string", "null"], "format": "date-time"},
          "expiry_policy": {"enum": ["DECAY", "FIXED_DATE", "UNTIL_REMOVED", "SESSION_ONLY"]},
          "evidence_event_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "user_confirmed_at": {"type": ["string", "null"], "format": "date-time"},
          "user_corrected_at": {"type": ["string", "null"], "format": "date-time"},
          "deleted_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "aggregate_tide_opt_in": {"type": "boolean"},
    "product_improvement_opt_in": {"type": "boolean"},
    "model_evaluation_opt_in": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
