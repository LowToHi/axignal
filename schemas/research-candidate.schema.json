{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axignal.com/schemas/research-candidate.schema.json",
  "title": "AXIGNAL Research Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "question", "origin", "scope", "priority_dimensions", "state", "privacy_scope", "research_plan", "created_at"],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^rcq_[A-Za-z0-9_-]{8,}$"},
    "question": {"type": "string", "minLength": 10},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_type", "references"],
      "properties": {
        "origin_type": {"enum": ["KNOWLEDGE_TIDE", "FAILED_SEARCH", "COVERAGE_GAP", "CONTRADICTION", "SOURCE_EVENT", "REGULATORY_EVENT", "USER_REQUEST", "ENTERPRISE_PRIVATE", "MODEL_ANOMALY", "SCHEDULED_REFRESH"]},
        "references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geographies", "entities", "universes"],
      "properties": {
        "geographies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "entities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "universes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "priority_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualified_attention", "persistence", "organisation_diversity", "coverage_gap", "external_evidence_gap", "buyer_value", "source_feasibility", "rights_confidence", "estimated_cost", "regulatory_complexity", "manipulation_risk"],
      "properties": {
        "qualified_attention": {"type": "number", "minimum": 0, "maximum": 1},
        "persistence": {"type": "number", "minimum": 0, "maximum": 1},
        "organisation_diversity": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage_gap": {"type": "number", "minimum": 0, "maximum": 1},
        "external_evidence_gap": {"type": "number", "minimum": 0, "maximum": 1},
        "buyer_value": {"type": "number", "minimum": 0, "maximum": 1},
        "source_feasibility": {"type": "number", "minimum": 0, "maximum": 1},
        "rights_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "estimated_cost": {"type": "number", "minimum": 0},
        "regulatory_complexity": {"type": "number", "minimum": 0, "maximum": 1},
        "manipulation_risk": {"type": "number", "minimum": 0, "maximum": 1},
        "learning_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "state": {"enum": ["PROPOSED", "ELIGIBILITY_REVIEW", "PRIORITISED", "RESEARCHING", "EVIDENCE_COLLECTED", "CLAIMS_PROPOSED", "ADMISSION_REVIEW", "COMPLETED", "PRIVACY_SUPPRESSED", "RIGHTS_BLOCKED", "REGULATORY_BLOCKED", "DUPLICATE", "MANIPULATION_SUSPECTED", "INSUFFICIENT_VALUE", "EXPIRED", "REJECTED", "PAUSED"]},
    "privacy_scope": {"enum": ["GLOBAL_AGGREGATE", "TENANT_PRIVATE", "USER_PRIVATE", "INTERNAL_ONLY"]},
    "research_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["falsification_conditions", "required_claim_types", "sources_to_evaluate", "cost_budget", "stopping_rule"],
      "properties": {
        "falsification_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "required_claim_types": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "sources_to_evaluate": {"type": "array", "items": {"type": "string"}},
        "cost_budget": {"type": "number", "minimum": 0},
        "human_review_required": {"type": "boolean"},
        "stopping_rule": {"type": "string", "minLength": 3}
      }
    },
    "owner": {"type": ["string", "null"]},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
