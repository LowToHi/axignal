{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axignal.com/schemas/security-threat-model.schema.json",
  "title": "AXIGNAL P03 Security Threat Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "programme_version",
    "status",
    "methodology",
    "assets",
    "trust_boundaries",
    "threats",
    "adversarial_cases"
  ],
  "properties": {
    "schema_version": {
      "const": "axignal.security-threat-model/v0.1"
    },
    "task_id": {
      "const": "AX-GE2E-P03-T01"
    },
    "programme_version": {
      "const": "1.4.0"
    },
    "status": {
      "enum": [
        "DRAFT_ENGINEERING_FOUNDATION",
        "EVIDENCE_READY",
        "ACCEPTED",
        "SUPERSEDED"
      ]
    },
    "methodology": {
      "const": "STRIDE_PLUS_RIGHTS_PRIVACY_AND_EPISTEMIC_AUTHORITY"
    },
    "assets": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "trust_boundaries": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/trustBoundary"
      }
    },
    "threats": {
      "type": "array",
      "minItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/threat"
      }
    },
    "adversarial_cases": {
      "type": "array",
      "minItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/adversarialCase"
      }
    }
  },
  "$defs": {
    "trustBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_id",
        "from",
        "to",
        "rule"
      ],
      "properties": {
        "boundary_id": {
          "pattern": "^AX-P03-TB-[0-9]{2}$"
        },
        "from": {
          "type": "string",
          "minLength": 2
        },
        "to": {
          "type": "string",
          "minLength": 2
        },
        "rule": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threat_id",
        "category",
        "scenario",
        "mandatory_controls",
        "expected_decision",
        "adversarial_case_id"
      ],
      "properties": {
        "threat_id": {
          "pattern": "^AX-P03-TH-[0-9]{3}$"
        },
        "category": {
          "type": "string",
          "minLength": 3
        },
        "scenario": {
          "type": "string",
          "minLength": 20
        },
        "mandatory_controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "expected_decision": {
          "enum": [
            "DENY",
            "DENY_NON_DISCLOSING",
            "FAIL_CLOSED",
            "REDACT_OR_DENY",
            "ALERT_AND_FAIL_CLOSED",
            "REDACT_AND_REVOKE"
          ]
        },
        "adversarial_case_id": {
          "pattern": "^AX-P03-ADV-[0-9]{3}$"
        }
      }
    },
    "adversarialCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "threat_id",
        "input_condition",
        "expected_decision",
        "must_preserve"
      ],
      "properties": {
        "case_id": {
          "pattern": "^AX-P03-ADV-[0-9]{3}$"
        },
        "threat_id": {
          "pattern": "^AX-P03-TH-[0-9]{3}$"
        },
        "input_condition": {
          "type": "string",
          "minLength": 20
        },
        "expected_decision": {
          "enum": [
            "DENY",
            "DENY_NON_DISCLOSING",
            "FAIL_CLOSED",
            "REDACT_OR_DENY",
            "ALERT_AND_FAIL_CLOSED",
            "REDACT_AND_REVOKE"
          ]
        },
        "must_preserve": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
