{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://axignal.com/schemas/source-admission-cases.schema.json","title":"AXIGNAL P04 Source Admission Adversarial Cases","type":"object","additionalProperties":false,"required":["schema_version","task_id","threats","adversarial_cases"],"properties":{"schema_version":{"const":"axignal.source-admission-cases/v0.1"},"task_id":{"const":"AX-GE2E-P04-T01"},"threats":{"type":"array","minItems":32,"maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["threat_id","category","scenario","control_gate_id","severity","required_result"],"properties":{"threat_id":{"pattern":"^P04-T[0-9]{2}$"},"category":{"type":"string"},"scenario":{"type":"string","minLength":20},"control_gate_id":{"pattern":"^G[0-9]{2}_[A-Z_]+$"},"severity":{"enum":["HIGH","CRITICAL"]},"required_result":{"enum":["DENY","QUARANTINE","SUSPEND"]}}}},"adversarial_cases":{"type":"array","minItems":32,"maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["case_id","threat_id","fixture","expected_gate_id","expected_result","canonical_admission_delta"],"properties":{"case_id":{"pattern":"^P04-C[0-9]{2}$"},"threat_id":{"pattern":"^P04-T[0-9]{2}$"},"fixture":{"pattern":"^[a-z0-9_]+\\.json$"},"expected_gate_id":{"pattern":"^G[0-9]{2}_[A-Z_]+$"},"expected_result":{"enum":["DENY","QUARANTINE","SUSPEND"]},"canonical_admission_delta":{"const":0}}}}}}