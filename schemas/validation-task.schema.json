{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axignal.com/schemas/validation-task.schema.json",
  "title": "AXIGNAL Frozen Validation Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "experiment_version",
    "language",
    "title",
    "content_hash",
    "participant_payload",
    "answer_key",
    "frozen"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^F1-[A-Z0-9-]+$" },
    "experiment_version": { "const": "f1-qualified-user@0.1.0" },
    "language": { "enum": ["en", "es"] },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "participant_payload": {
      "type": "object",
      "required": ["prompt", "statement", "evidence", "unknowns"],
      "properties": {
        "prompt": { "type": "string" },
        "statement": { "type": "string" },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "unknowns": { "type": "array", "items": { "type": "object" } }
      }
    },
    "answer_key": {
      "type": "object",
      "required": [
        "authority_layer",
        "required_evidence_ids",
        "required_unknowns",
        "critical_error_layers",
        "reference_answer"
      ]
    },
    "frozen": { "const": true }
  }
}
